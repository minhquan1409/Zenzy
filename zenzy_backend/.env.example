# Copy to .env for local runs (never commit .env). In production these values come from
# AWS SSM Parameter Store (see docs/DEPLOY-AWS.md), not from a file in the repository.

NODE_ENV=development
# Host/cổng của server KHÔNG đặt ở đây: sửa trong src/core/address.ts (nguồn duy nhất).
# Docker / AWS tự đặt PORT và HOST=0.0.0.0 qua biến môi trường.

# MongoDB. Local: the replica set from docker-compose.dev.yml. Production: the Atlas SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
# Bản localhost dùng DB riêng zenzylocaldemo (cùng cluster Atlas với DB thật). Bản deploy: zenzy.
MONGODB_DB=zenzylocaldemo

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# NFR-08 defaults: 15-minute access tokens, 30-day rotated refresh tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# Google sign-in: comma-separated OAuth client IDs whose ID tokens are accepted
# (the Android client ID and/or the Web client ID used by the app). Empty = Google sign-in returns 401.
GOOGLE_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=

# Browser origins allowed to call the API (admin dashboard). The Android app does not need CORS.
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Caddy on EC2) so rate limiting sees the real client IP.
TRUST_PROXY=0

# Media uploads (POST /uploads/sign). Empty = uploads return 503 UPLOADS_NOT_CONFIGURED.
AWS_REGION=ap-southeast-1
S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=

# Outgoing e-mail for "forgot password" codes, over SMTP. Works with Gmail (App Password, port 587),
# Amazon SES SMTP, Brevo... Empty SMTP_HOST = development logs the code and returns it as dev_code;
# production answers 503 MAIL_NOT_CONFIGURED.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zenzy <no-reply@example.com>
PASSWORD_RESET_TTL_MINUTES=10

# Push notifications through FCM: base64 of the Firebase service-account JSON. Empty = no push
# (the in-app notification list and socket events still work).
FCM_SERVICE_ACCOUNT_BASE64=

# Background jobs: end past events and deals, stop expired time-limited sharing.
JOBS_ENABLED=true

# E-mail verification of new accounts: minutes a sign-up code is valid, and sign-ups per IP every 15 minutes.
SIGNUP_CODE_TTL_MINUTES=15
SIGNUP_IP_LIMIT=5

# Admin web page (/admin/): 3 wrong sign-ins from one IP block it for 24 hours and e-mail this address.
# The admin account is created with: ADMIN_USERNAME=... ADMIN_PASSWORD=... npm run db:init
ADMIN_ALERT_EMAIL=
ADMIN_MAX_FAILURES=3
ADMIN_BLOCK_HOURS=24

# APK download page password (checked by the API for Caddy forward_auth). The bcrypt hash is base64-encoded.
# Production values are written to SSM by deploy/aws/deploy-site.ps1.
DOWNLOAD_USER=
DOWNLOAD_PASSWORD_HASH_B64=
DOWNLOAD_MAX_FAILURES=10
DOWNLOAD_BLOCK_HOURS=24

# Anti-scraping. RATE_LIMIT_SCALE multiplies every request limit (0 = off). Opening more than
# SCRAPE_PROFILE_LIMIT strangers' profiles in an hour pauses browsing for SCRAPE_LOCK_MINUTES (admin e-mailed).
# Moving the map / NEARBY centre more than GEO_JUMP_KM within 10 minutes counts as a jump; GEO_JUMPS_PER_HOUR allowed.
RATE_LIMIT_SCALE=1
SCRAPE_PROFILE_LIMIT=60
SCRAPE_LOCK_MINUTES=60
GEO_JUMP_KM=50
GEO_JUMPS_PER_HOUR=5
