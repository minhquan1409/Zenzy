# Sao chép thành .env rồi điền giá trị thật. Không commit .env.
# Địa chỉ server (host, cổng, URL công khai, CORS) KHÔNG đặt ở đây: sửa trong src/common/config.ts.
# Chuỗi kết nối MongoDB Atlas (mongodb+srv://user:password@cluster.../)
MONGODB_URI=
# DB riêng cho bản localhost, cùng cluster với DB "Zenzy" cũ (MongoDB tự tạo khi ghi lần đầu). Deploy: đổi thành Zenzy.
MONGODB_DB=zenzylocaldemo
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
# Tự nạp dữ liệu mẫu khi database còn trống
SEED_ON_BOOT=true
