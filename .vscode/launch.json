{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Zenzy App (Emulator)",
      "request": "launch",
      "type": "dart",
      "cwd": "zenzy_frontend",
      "program": "zenzy_frontend/lib/main.dart",
      "toolArgs": [
        "--dart-define=GOOGLE_WEB_CLIENT_ID=295741052942-88iii8ju97el1jaoik478jrtmqm21pva.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Zenzy App (Điện thoại thật)",
      "request": "launch",
      "type": "dart",
      "cwd": "zenzy_frontend",
      "program": "zenzy_frontend/lib/main.dart",
      "preLaunchTask": "adb reverse 3100",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://127.0.0.1:3100/v1",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=295741052942-88iii8ju97el1jaoik478jrtmqm21pva.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Zenzy App (Server AWS)",
      "request": "launch",
      "type": "dart",
      "cwd": "zenzy_frontend",
      "program": "zenzy_frontend/lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=https://zenzy.dpdns.org/v1",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=295741052942-88iii8ju97el1jaoik478jrtmqm21pva.apps.googleusercontent.com"
      ]
    },
    {
      "name": "Zenzy Backend (Debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/zenzy_backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "-r",
        "ts-node/register",
        "src/main.ts"
      ],
      "console": "integratedTerminal",
      "restart": true
    }
  ]
}
